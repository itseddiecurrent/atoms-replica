{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.acceptance",
    "watchPatterns": [
      "/Dockerfile.acceptance",
      "/scripts/live-smoke.mjs",
      "/scripts/preview-smoke.mjs",
      "/scripts/first-generation-evidence.mjs",
      "/scripts/first-generation-evidence.test.mjs",
      "/scripts/preview-acceptance.mjs",
      "/scripts/preview-acceptance.test.mjs",
      "/scripts/incremental-smoke.mjs",
      "/scripts/incremental-acceptance.mjs",
      "/scripts/incremental-acceptance.test.mjs",
      "/scripts/persistence-smoke.mjs",
      "/scripts/persistence-acceptance.mjs",
      "/scripts/persistence-acceptance.test.mjs",
      "/scripts/persistence-browser.mjs",
      "/scripts/production-smoke.mjs",
      "/scripts/production-smoke-acceptance.mjs",
      "/scripts/production-smoke-acceptance.test.mjs"
    ]
  },
  "deploy": {
    "startCommand": "node --trace-uncaught --enable-source-maps scripts/production-smoke.mjs",
    "restartPolicyType": "NEVER"
  }
}
