{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "node --check scripts/live-smoke.mjs && node --test scripts/first-generation-evidence.test.mjs",
    "watchPatterns": [
      "/scripts/live-smoke.mjs",
      "/scripts/first-generation-evidence.mjs",
      "/scripts/first-generation-evidence.test.mjs",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm test:generation",
    "restartPolicyType": "NEVER"
  }
}
