    "@atom-replica/sandbox": "workspace:*",
    "@atom-replica/shared": "workspace:*",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
