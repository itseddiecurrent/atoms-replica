{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @atom-replica/worker... build",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/agent/**",
      "/packages/db/**",
      "/packages/sandbox/**",
      "/packages/shared/**",
      "/templates/react-vite/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter worker start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
