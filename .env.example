# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
E2B_PREVIEW_CSP_ORIGIN=https://*.e2b.app
SESSION_COOKIE_NAME=atom_demo_session
APP_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# OpenAI (server/worker only)
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=<responses-api-model-id>
OPENAI_MAX_OUTPUT_TOKENS=12000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=project-snapshots
DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:6543/postgres?sslmode=require
DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<storage-bucket>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>

# Firebase Admin SDK (server only)
FIREBASE_ADMIN_PROJECT_ID=<project-id>
FIREBASE_ADMIN_CLIENT_EMAIL=<service-account-email>
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<private-key>\n-----END PRIVATE KEY-----\n"

# E2B (server/worker only)
E2B_API_KEY=<e2b-api-key>
E2B_TEMPLATE_ID=
E2B_SANDBOX_TIMEOUT_SECONDS=900
E2B_PREVIEW_PORT=5173

# PostgreSQL polling worker and SSE
WORKER_CONCURRENCY=1
WORKER_DISABLED=false
WORKER_POLL_INTERVAL_MS=1000
SSE_POLL_INTERVAL_MS=500
RUN_HEARTBEAT_INTERVAL_MS=5000
RUN_STALE_AFTER_SECONDS=30

# Agent limits
MAX_AGENT_TURNS=20
MAX_AGENT_TOOL_CALLS=60
MAX_AGENT_REPAIR_ATTEMPTS=2
MAX_RUN_DURATION_SECONDS=600
MAX_COMMAND_DURATION_SECONDS=120
MAX_PROJECT_FILES=200
MAX_PROJECT_SIZE_BYTES=10485760
MAX_DAILY_RUNS_PER_USER=20
MAX_MESSAGES_PER_MINUTE_PER_USER=6
MAX_CONCURRENT_RUNS_PER_USER=1

# Optional monitoring
SENTRY_DSN=

# Live Playwright smoke test (test runner only; never set on Web/Worker)
E2E_BASE_URL=http://localhost:3000
E2E_EMAIL=<dedicated-test-account-email>
E2E_PASSWORD=<dedicated-test-account-password>
