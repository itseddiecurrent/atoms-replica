NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<worker-service-role-key>
SUPABASE_STORAGE_BUCKET=project-snapshots
DATABASE_URL=postgresql://<pooler-user>:<password>@<pooler-host>:6543/postgres?sslmode=require
OPENAI_API_KEY=<openai-project-api-key>
OPENAI_MODEL=<responses-api-model-id>
OPENAI_MAX_OUTPUT_TOKENS=12000
E2B_API_KEY=<e2b-api-key>
E2B_TEMPLATE_ID=
E2B_SANDBOX_TIMEOUT_SECONDS=900
E2B_PREVIEW_PORT=5173
WORKER_CONCURRENCY=1
WORKER_DISABLED=false
WORKER_POLL_INTERVAL_MS=1000
RUN_HEARTBEAT_INTERVAL_MS=5000
RUN_STALE_AFTER_SECONDS=30
MAX_AGENT_TURNS=20
MAX_AGENT_TOOL_CALLS=60
MAX_AGENT_REPAIR_ATTEMPTS=2
MAX_RUN_DURATION_SECONDS=600
MAX_COMMAND_DURATION_SECONDS=120
SENTRY_DSN=
