FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates chromium \
  && rm -rf /var/lib/apt/lists/*

ENV E2E_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
WORKDIR /app

COPY scripts ./scripts

RUN node --check scripts/live-smoke.mjs \
  && node --check scripts/incremental-smoke.mjs \
  && node --check scripts/incremental-acceptance.mjs \
  && node --check scripts/persistence-smoke.mjs \
  && node --check scripts/persistence-acceptance.mjs \
  && node --check scripts/persistence-browser.mjs \
  && node --check scripts/preview-smoke.mjs \
  && node --check scripts/preview-acceptance.mjs \
  && node --test scripts/first-generation-evidence.test.mjs scripts/preview-acceptance.test.mjs scripts/incremental-acceptance.test.mjs scripts/persistence-acceptance.test.mjs

CMD ["node", "scripts/persistence-smoke.mjs"]
